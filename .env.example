# Preencher em .env.local e nas variáveis do provedor de hospedagem.
RESEND_API_KEY=
# Endereço remetente de domínio verificado no Resend, não o Gmail destinatário.
CONTACT_FROM_EMAIL=
# URL pública final, incluindo https:// (sem barra no final).
SITE_URL=
# ID do Meta Pixel (conjunto de dados). Prefixo NEXT_PUBLIC_ expõe ao client-side.
NEXT_PUBLIC_META_PIXEL_ID=
